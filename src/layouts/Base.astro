---
// The serif for everything the site says, and the handwriting face that is
// used for wish notes and nowhere else. Both are served from this site.
import '@fontsource-variable/eb-garamond/wght.css';
import '@fontsource-variable/eb-garamond/wght-italic.css';
import '@fontsource/cedarville-cursive/latin-400.css';
import '../styles/base.css';
import serifUrl from '@fontsource-variable/eb-garamond/files/eb-garamond-latin-wght-normal.woff2?url';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { collectionNames, collectionSlugs } from '../data/collections';
import { site } from '../data/site';
import { instagramProfileUrl, withBase } from '../lib/links';
import { loadPieces } from '../lib/work';

interface Props {
  /** Page name. Left out on the home page. */
  title?: string;
  description?: string;
  /** Image shown when this page's link is shared in a chat. */
  shareImage?: ImageMetadata;
  /** Keeps the page out of search results. For the not-found page. */
  noindex?: boolean;
}

const { title, description = site.description, shareImage, noindex = false } = Astro.props;

const pieces = await loadPieces();
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.titleLine}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Chat apps read these tags without running any script, and are most
// reliable with a JPEG at the standard 1200 x 630 preview size.
const previewSource = shareImage ?? pieces[0]?.images[0].src;
const preview = previewSource
  ? await getImage({ src: previewSource, width: 1200, height: 630, fit: 'cover', format: 'jpeg' })
  : undefined;
const previewUrl = preview ? new URL(preview.src, Astro.site) : undefined;

const orderHref = withBase('/contact');
// The menu lists a collection only once it has a piece to show.
const pages = [
  ...collectionSlugs
    .filter((slug) => pieces.some((piece) => piece.collection === slug))
    .map((slug) => ({ href: withBase(`/${slug}`), label: collectionNames[slug] })),
  { href: withBase('/offer'), label: 'What I offer' },
  { href: withBase('/about'), label: 'About' },
  { href: orderHref, label: site.orderLabel },
];
const here = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="theme-color" content="#f5efe4" />
    <!-- Fetched early, so the page's words appear in their own typeface. -->
    <link rel="preload" as="font" type="font/woff2" href={serifUrl} crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {previewUrl && <meta property="og:image" content={previewUrl} />}
    {previewUrl && <meta property="og:image:width" content="1200" />}
    {previewUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={previewUrl ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={withBase('/')}>{site.name}</a>
      <nav aria-label="Main">
        <ul>
          {
            pages.map((page) => (
              <li>
                <a href={page.href} aria-current={here === page.href ? 'page' : undefined}>
                  {page.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      {
        // Every page ends with the way to order, except the order page itself.
        here !== orderHref && (
          <div class="order-band">
            <p>Every piece begins with a wish.</p>
            <a class="button" href={orderHref}>
              {site.orderLabel}
            </a>
          </div>
        )
      }
      <div class="footer-notes">
        <p class="signoff">{site.signoff}</p>
        <p>Fatema Boxwala, {site.credential}</p>
        <p>{site.location}</p>
        <p>
          <a href={instagramProfileUrl(site.instagram)} rel="noopener">Instagram @{site.instagram}</a>
        </p>
      </div>
    </footer>
  </body>
</html>
